# Supabase project settings — Project Settings → API in the Supabase dashboard.
# The anon key is safe to expose to the browser (NEXT_PUBLIC_*); Row Level
# Security policies in supabase/migrations/0001_init.sql are what actually
# gate access, not this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Server-only key that BYPASSES Row Level Security — never expose it to
# the browser and never use it in per-user request paths. Only for admin/seed
# scripts and server-side logging of anonymous workflow imports.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
